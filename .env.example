# ---------------------------------------------------------------------------
# Ummah Connect — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API). `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser. Bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute site URL, used for auth redirect links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER prefix with NEXT_PUBLIC and never import into client code.
# Bypasses Row Level Security. Used for seeding and admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only — Stage 7 (AI). The app must work without this set.
ANTHROPIC_API_KEY=

# Server only — protects the optional opportunity-expiry cron route.
CRON_SECRET=
